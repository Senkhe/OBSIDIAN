<!doctype html>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Opening Obsidian…</title>
<p id="msg">Opening Obsidian…</p>
<script>
  const raw = decodeURIComponent(location.search.slice(1));
  const msg = document.getElementById("msg");
  if (raw.startsWith("obsidian://")) {
    const a = document.createElement("a");
    a.href = raw;
    a.textContent = "Click here if Obsidian didn't open";
    msg.textContent = "";
    msg.appendChild(a);
    location.href = raw;
  } else {
    msg.textContent = "Link must start with obsidian://";
  }
</script>
